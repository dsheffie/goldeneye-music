# Nothing derived from a ROM is ever committed: not the ROM, not extracted or
# rendered audio, not code generated from the microcode, not dumped IR.
*.z64
*.n64
*.v64
music/
RCP_STUB_SPEC.md
rsp_*.ll
*.wav
*.flac

# build output
obj/
build/
gemusic/web/dist/
gemusic/gemusic
gemusic/gemms
gemusic/tests/adpcm_test
gemusic/tests/r4300_cfg
gemusic/tests/r4300_indirect
cfg/
*.dot
__pycache__/
*.o
*.d
*.pyc
*~

# analysis dumps from the R4300 tooling
gemusic/r4300_indirect.txt
gemusic/r4300_pcs.txt
gemusic/r4300_ram.bin
gemusic/tests/n64_boot
r4300bt_*.ll
r4300_*.dot

# demo ROM build outputs
demo/*/build/
demo/*/filesystem/
demo/*/*.z64

# supersaw's wavetables are generated by mkwaves.py -- keep the generator, not its output
demo/supersaw/assets/

# autoplay and vadpcm are local test fixtures that play libdragon's bundled example
# music.  libdragon's code is public domain; those compositions and samples are their
# authors' and are not ours to redistribute, so the assets stay out and the READMEs say
# where to copy them from.
demo/autoplay/assets/
demo/vadpcm/assets/
